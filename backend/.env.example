# --- App ---
APP_ENV=production
TZ=America/Argentina/Buenos_Aires
SQLITE_PATH=/data/app.db
CORS_ORIGINS=http://localhost:8085,http://10.0.0.69:8085

# --- Auth ---
# generate with: openssl rand -hex 32
JWT_SECRET=change-me
JWT_ALG=HS256
JWT_EXPIRES_MIN=60
ADMIN_USERNAME=nico
ADMIN_PASSWORD=change-me-on-first-boot

# --- Encryption (IOL creds + tokens) ---
# generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me

# --- IOL ---
IOL_BASE_URL=https://api.invertironline.com
IOL_TOKEN_PATH=/token
IOL_HTTP_TIMEOUT=20

# --- Dolar ---
DOLARAPI_BASE=https://dolarapi.com/v1
DEFAULT_DOLAR_SOURCE=MEP

# --- Binance (optional read-only key — lifts rate limits, reduces geo-blocking) ---
# Create at binance.com → Profile → API Management → Enable Reading only
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Scheduler ---
SCHEDULER_ENABLED=true
SNAPSHOT_CRON=55 23 * * *
DOLAR_CRON_MORNING=0 8 * * *
DOLAR_CRON_EVENING=50 23 * * *
OPERATIONS_YEAR=2026
